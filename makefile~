CC := gcc
CFLAGS := -m64 -Wall -Wextra -Werror -ffreestanding -no-pie
AS := nasm
ASFLAGS :=
LD := ld
LDFLAGS :=
LDSCRIPT := kernel.ld

BUILDDIR := build
SRCDIR := src
LIMINEDIR := limine

KERNEL := $(BUILDDIR)/kernel.bin
DISK := $(BUILDDIR)/disk.img

C_SRCS := $(wildcard $(SRCDIR)/*.c)
C_OBJS := $(patsubst $(SRCDIR)/%.c, $(BUILDDIR)/%.o, $(C_SRCS))

$(BUILDDIR)/%.o: $(SRCDIR)/%.c | $(BUILDDIR)
	@$(CC) $(CFLAGS) -c -o $@ $^

$(KERNEL): $(C_OBJS) | $(BUILDDIR)
	@$(LD) $(LDFLAGS) -T $(LDSCRIPT) -o $@ $^

$(DISK): $(KERNEL) | limine_build
	@dd if=/dev/zero bs=1M count=64 of=$@
	@echo 'type=0c, bootable' | sfdisk -q $@
	@mformat -i $@@@1M -F ::
	@mmd -i $@@@1M ::/EFI ::/EFI/BOOT ::/boot ::/boot/limine
	@mcopy -i $@@@1M $< ::/boot/kernel
	@mcopy -i $@@@1M limine.conf $(LIMINEDIR)/limine-bios.sys ::/boot/limine
	@mcopy -i $@@@1M $(LIMINEDIR)/BOOTX64.EFI ::/EFI/BOOT
	@./$(LIMINEDIR)/limine bios-install $@

limine_build: $(LIMINEDIR)
	@make -C $<

run: $(DISK)
	@qemu-system-x86_64 -hda $<

disk: $(DISK)

clean:
	@rm -rf $(BUILDDIR)

$(BUILDDIR):
	@mkdir -p $@

$(LIMINEDIR):
	@git clone https://codeberg.org/Limine/Limine.git $@ --branch=v10.x-binary --depth=1
